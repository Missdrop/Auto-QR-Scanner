{
  "manifest_version": 3,
  "name": "Auto QR Scanner Companion",
  "version": "0.1.0",
  "description": "Connect the AMS student session to the local Auto QR Scanner application.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ams.xjtlu.edu.cn/studenth5/*",
        "https://ams.xjtlu.edu.cn/studentpc/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
